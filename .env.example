# Configuración de Entorno para LetsGo - Guía Turística de Puntarenas

SECRET_KEY=django-insecure-cambia-esto-en-produccion-puntarenas-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos:
# Si USE_POSTGRES=False, Django usará automáticamente SQLite (db.sqlite3)
USE_POSTGRES=False
DB_NAME=letsgo_db
DB_USER=postgres
DB_PASSWORD=tu_password_aqui
DB_HOST=localhost
DB_PORT=5432

# Caché y Sesiones:
# Si USE_REDIS=False, Django usará la base de datos para sesiones y LocMem para caché
USE_REDIS=False
REDIS_URL=redis://127.0.0.1:6379/1
